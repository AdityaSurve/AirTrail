# Live API during `npm run dev`: leave empty so the browser calls `/api/...` and Vite
# proxies to Flask on http://localhost:5000 (avoids direct :5000 from the browser).
# VITE_API_BASE_URL=

# Production or when not using the dev proxy (full origin, no trailing slash):
# VITE_API_BASE_URL=http://127.0.0.1:5000

# Set to true to disable all API calls (empty charts until turned off):
# VITE_USE_SAMPLE_ONLY=true
